# =================================================================
# Google Gemini API & Models
# =================================================================
GEMINI_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=1536

# =================================================================
# RAG Version & Retrieval Hyperparameters
# =================================================================
# Default pipeline version: v1 (Dense RAG), v2 (Hybrid + Reranking), v3 (Controlled Agentic RAG)
RAG_VERSION=v1
RAG_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.40

# =================================================================
# Version 2 (Hybrid Retrieval & Cross-Encoder Reranking)
# =================================================================
BM25_CANDIDATES=10
DENSE_CANDIDATES=10
FINAL_TOP_K=4
RRF_K=60
HYBRID_DENSE_WEIGHT=0.5
HYBRID_BM25_WEIGHT=0.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu

# =================================================================
# Version 3 (Controlled Agentic RAG)
# =================================================================
MAX_AGENT_STEPS=5
